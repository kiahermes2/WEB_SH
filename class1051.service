[Unit]
Description=Class 1051 Study Planner Web Portal Service
After=network.target

[Service]
Type=simple
User=root
# Change WorkingDirectory to the path where you placed the deploy folder on your server
WorkingDirectory=/var/www/class1051
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=0.0.0.0

[Install]
WantedBy=multi-user.target
